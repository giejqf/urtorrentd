{
  "name": "@urtorrentd/web",
  "version": "0.14.1",
  "private": true,
  "type": "module",
  "description": "The web UI of urtorrentd: a client of the HTTP API (see AGENTS.md).",
  "license": "Apache-2.0",
  "scripts": {
    "generate": "openapi-typescript ../openapi.json -o src/api/schema.d.ts",
    "prepare": "npm run generate",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run generate && npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "e2e": "npm run build && cargo build -q -p urtorrentd && playwright test --project=chromium",
    "e2e:all": "npm run build && cargo build -q -p urtorrentd && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@kobalte/core": "0.13.14",
    "@solidjs/router": "1.0.0",
    "@tanstack/solid-query": "5.103.2",
    "@tanstack/solid-virtual": "3.13.40",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-solid": "1.48.0",
    "openapi-fetch": "0.17.0",
    "solid-js": "1.9.15",
    "solid-sonner": "0.3.2",
    "tailwind-merge": "3.7.0",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "eslint-plugin-solid": "0.18.0",
    "globals": "17.12.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.1"
  }
}
